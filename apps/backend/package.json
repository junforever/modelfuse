{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest",
    "test:consolidation-eval": "tsx src/acceptance/consolidationEvaluation.ts",
    "test:acceptance-terminal": "vitest run src/acceptance/terminalStates.acceptance.test.ts",
    "test:acceptance-latency": "vitest run src/acceptance/latency.acceptance.test.ts",
    "dev": "tsx watch --env-file .env --conditions development src/index.ts"
  },
  "keywords": [],
  "author": "junforever",
  "license": "Proprietary",
  "description": "",
  "dependencies": {
    "axios": "^1.18.1",
    "connect-timeout": "^1.9.1",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/connect-timeout": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.10"
  },
  "imports": {
    "#middleware/*": {
      "development": "./src/middleware/*.ts",
      "default": "./dist/middleware/*.js"
    },
    "#controllers/*": {
      "development": "./src/controllers/*.ts",
      "default": "./dist/controllers/*.js"
    },
    "#routes/*": {
      "development": "./src/routes/*.ts",
      "default": "./dist/routes/*.js"
    },
    "#utils/*": {
      "development": "./src/utils/*.ts",
      "default": "./dist/utils/*.js"
    },
    "#infrastructure/*": {
      "development": "./src/infrastructure/*.ts",
      "default": "./dist/infrastructure/*.js"
    }
  }
}
